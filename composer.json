{
    "name": "wyyr/crudbooster",
    "description": "Community Edition of CRUDBooster, a CRUD Generator Based On Laravel Easy To Make An Advanced Backend",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "admin-panel",
        "backend",
        "crud-generator",
        "crudbooster",
        "crud",
        "generator"
    ],
    "authors": [
        {
            "name": "Wayy",
            "email": "wyyr@pm.me"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2|^8.3",
        "laravel/framework": "^12.69|^13.30",
        "barryvdh/laravel-dompdf": "^3.0",
        "maatwebsite/excel": "^3.1",
        "intervention/image": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "crocodicstudio\\crudbooster\\": "src/"
        },
        "classmap": [
            "src/database/migrations"
        ],
        "exclude-from-classmap": [
            "src/public/crudbooster",
            "src/database/seeders/",
            "src/userfiles/"
        ],
        "files": [
            "src/helpers/Helper.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "crocodicstudio\\crudbooster\\CRUDBoosterServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.30.4",
        "orchestra/workbench": "^10.3"
    }
}