{
    "name": "wyyr/crudbooster",
    "description": "Community Edition of CRUDBooster, a CRUD Generator Based On Laravel Easy To Make An Advanced Backend",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "admin-panel",
        "backend",
        "crud-generator",
        "crudbooster",
        "crud",
        "generator"
    ],
    "authors": [
        {
            "name": "Wayy",
            "email": "wyyr@pm.me"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "laravel/framework": "^8.0|^9.0|^10.0",
        "barryvdh/laravel-dompdf": "^2.0|^3.0",
        "doctrine/dbal": "^3.0|^4.0",
        "maatwebsite/excel": "^3.1",
        "intervention/image": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "crocodicstudio\\crudbooster\\": "src/"
        },
        "files": [
            "src/helpers/Helper.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "crocodicstudio\\crudbooster\\CRUDBoosterServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/pint": "^1.20"
    }
}
