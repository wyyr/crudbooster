{
    "name": "wyyr/crudbooster",
    "description": "Community-maintained fork of CRUDBooster 5.x, bringing the classic Laravel CRUD generator up to date for PHP 8.2+ and Laravel 12/13",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "admin-panel",
        "backend",
        "crud-generator",
        "crudbooster",
        "crud",
        "generator"
    ],
    "authors": [
        {
            "name": "Ferry",
            "email": "ferry@crocodic.com",
            "role": "Original Author"
        },
        {
            "name": "Wayy",
            "email": "wyyr@pm.me",
            "homepage": "https://github.com/wyyr",
            "role": "Maintainer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2|^8.3",
        "laravel/framework": "^12.69|^13.30",
        "barryvdh/laravel-dompdf": "^3.0",
        "maatwebsite/excel": "^3.1",
        "intervention/image": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "crocodicstudio\\crudbooster\\": "src/"
        },
        "classmap": [
            "src/database/migrations"
        ],
        "exclude-from-classmap": [
            "src/public/crudbooster",
            "src/database/seeders/",
            "src/userfiles/"
        ],
        "files": [
            "src/helpers/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Http\\Controllers\\CRUDBooster\\": "tests/Fixtures/Controllers/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "crocodicstudio\\crudbooster\\CRUDBoosterServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.30.4",
        "orchestra/workbench": "^10.3|^11.0",
        "pestphp/pest": "^3.8.2|^4.4.1",
        "pestphp/pest-plugin-laravel": "^3.2|^4.1"
    }
}